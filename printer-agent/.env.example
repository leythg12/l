# Flashforge M5 — find these on the printer screen:
#   Settings → Device → Serial Number
#   Settings → Device → Check Code  (also called "Registration Code")
#   Settings → Network → IP Address
PRINTER_IP=192.168.1.100
PRINTER_SERIAL=XXXXXXXXXXXXXXX
PRINTER_CHECK_CODE=XXXXXXXX

# Firebase service account JSON key file
# Download from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → save as serviceAccount.json next to this file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
