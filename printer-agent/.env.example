# IP address of your Flashforge M5 on the local network
# Find it in the printer's Settings → Network → IP Address
PRINTER_IP=192.168.1.100

# Firebase project ID (same as NEXT_PUBLIC_FIREBASE_PROJECT_ID in the web app)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to your Firebase service account JSON key file
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
